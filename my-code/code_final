// =====================================================
// SETUP
// =====================================================

void setup()
{
  Serial.begin(115200);

  // ---------------------------------------------------
  // RELAY
  // ---------------------------------------------------

  pinMode(RELAY_PIN, OUTPUT);
  digitalWrite(RELAY_PIN, RELAY_OFF);


  // ---------------------------------------------------
  // I2C
  // ---------------------------------------------------

  Wire.begin(SDA_PIN, SCL_PIN);


  // ---------------------------------------------------
  // LCD
  // ---------------------------------------------------

  int status = lcd.begin(16, 2);

  if (status)
  {
    Serial.print("LCD initialization failed, status = ");
    Serial.println(status);

    // Continue even if LCD fails.
  }
  else
  {
    lcd.backlight();
    lcd.clear();

    lcd.setCursor(0, 0);
    lcd.print("Smart Crop");

    lcd.setCursor(0, 1);
    lcd.print("System Starting");

    delay(2000);
  }


  // ---------------------------------------------------
  // DHT11
  // ---------------------------------------------------

  dht.begin();


  // ---------------------------------------------------
  // ADC
  // ---------------------------------------------------

  analogReadResolution(12);


  // ---------------------------------------------------
  // DEFAULT PLANT SELECTION
  // ---------------------------------------------------

  selectPlant(1);  // Default to Portulaca


  // ---------------------------------------------------
  // START ESP32 HOTSPOT
  // ---------------------------------------------------

  startAccessPoint();


  // ---------------------------------------------------
  // WEB SERVER
  // ---------------------------------------------------

  server.on("/", handleRoot);

  server.on("/data", handleData);

  server.on("/setplant", handleSetPlant);

  server.begin();

  Serial.println("Web server started.");


  // ---------------------------------------------------
  // SERIAL PLANT SELECTION INSTRUCTIONS
  // ---------------------------------------------------

  Serial.println();
  Serial.println("=============================================");
  Serial.println("PLANT SELECTION");
  Serial.println("=============================================");
  Serial.println("Send 1 = Portulaca (Pump ON < 40%, OFF >= 72%)");
  Serial.println("Send 2 = Moses-in-the-cradle (Pump ON < 55%, OFF >= 72%)");
  Serial.println("Send 3 = Periwinkle (Pump ON < 47%, OFF >= 72%)");
  Serial.println("=============================================");
  Serial.println();


  // ---------------------------------------------------
  // READY
  // ---------------------------------------------------

  if (status == 0)
  {
    lcd.clear();

    lcd.setCursor(0, 0);
    lcd.print("WiFi Ready");

    lcd.setCursor(0, 1);
    lcd.print("192.168.4.1");

    delay(2000);
  }
}


// =====================================================
// MAIN LOOP
// =====================================================

void loop()
{
  // ---------------------------------------------------
  // HANDLE WEB REQUESTS
  // ---------------------------------------------------

  server.handleClient();


  // ---------------------------------------------------
  // CHECK SERIAL INPUT FOR PLANT SELECTION
  // ---------------------------------------------------

  checkSerialInput();


  // ---------------------------------------------------
  // SOIL MOISTURE
  // ---------------------------------------------------

  soilRaw = analogRead(SOIL_PIN);

  soilMoisture = map(
    soilRaw,
    SOIL_DRY,
    SOIL_WET,
    0,
    100
  );

  soilMoisture = constrain(
    soilMoisture,
    0,
    100
  );


  // ---------------------------------------------------
  // RAIN SENSOR
  // ---------------------------------------------------

  rainRaw = analogRead(RAIN_PIN);

  rainPercentage = map(
    rainRaw,
    RAIN_DRY,
    RAIN_WET,
    0,
    100
  );

  rainPercentage = constrain(
    rainPercentage,
    0,
    100
  );


  // ---------------------------------------------------
  // WATER LEVEL SENSOR
  // ---------------------------------------------------

  waterRaw = analogRead(WATER_LEVEL_PIN);

  waterLevel = map(
    waterRaw,
    WATER_EMPTY,
    WATER_FULL,
    0,
    100
  );

  waterLevel = constrain(
    waterLevel,
    0,
    100
  );

  // Check if water level is too low for pump operation
  waterLow = (waterLevel < WATER_MIN_LEVEL);


  // ---------------------------------------------------
  // DHT11
  // ---------------------------------------------------

  humidity = dht.readHumidity();

  temperature = dht.readTemperature();


  if (isnan(humidity) || isnan(temperature))
  {
    Serial.println("DHT11 reading failed!");

    delay(1000);

    return;
  }


  // ---------------------------------------------------
  // INCREMENT READING COUNT
  // ---------------------------------------------------

  readingCount++;


  // ---------------------------------------------------
  // IRRIGATION CONTROL
  // ---------------------------------------------------

  irrigationControl();


  // ---------------------------------------------------
  // DISPLAY
  // ---------------------------------------------------

  displaySensorData();


  // ---------------------------------------------------
  // SERIAL MONITOR
  // ---------------------------------------------------

  printSerialData();


  delay(2000);
}


// =====================================================
// SELECT PLANT BY CODE (1, 2, or 3)
// =====================================================

void selectPlant(int plantCode)
{
  if (plantCode < 1 || plantCode > 3)
  {
    Serial.println("Invalid plant code. Use 1, 2, or 3.");
    return;
  }

  selectedPlant = plantCode - 1;  // Convert to 0-indexed

  MOISTURE_THRESHOLD = plants[selectedPlant].pumpOnBelow;
  MOISTURE_STOP = plants[selectedPlant].pumpOffAt;

  Serial.println();
  Serial.println("=============================================");
  Serial.print("PLANT SELECTED: ");
  Serial.println(plants[selectedPlant].name);
  Serial.print("Plant Code: ");
  Serial.println(plants[selectedPlant].code);
  Serial.print("Pump ON below: ");
  Serial.print(MOISTURE_THRESHOLD);
  Serial.println("%");
  Serial.print("Pump OFF at: ");
  Serial.print(MOISTURE_STOP);
  Serial.println("%");
  Serial.println("=============================================");
  Serial.println();
}


// =====================================================
// CHECK SERIAL INPUT FOR PLANT SELECTION
// =====================================================

void checkSerialInput()
{
  if (Serial.available() > 0)
  {
    String input = Serial.readStringUntil('\n');
    input.trim();

    int plantCode = input.toInt();

    if (plantCode >= 1 && plantCode <= 3)
    {
      selectPlant(plantCode);
    }
    else
    {
      Serial.println("Invalid input. Send 1, 2, or 3 to select a plant.");
    }
  }
}


// =====================================================
// START ESP32 ACCESS POINT
// =====================================================

void startAccessPoint()
{
  Serial.println();
  Serial.println("Starting ESP32 Wi-Fi Hotspot...");

  WiFi.mode(WIFI_AP);

  bool result = WiFi.softAP(
    AP_SSID,
    AP_PASSWORD
  );

  if (result)
  {
    Serial.println("Hotspot started successfully.");

    Serial.print("Wi-Fi Name: ");
    Serial.println(AP_SSID);

    Serial.print("Wi-Fi Password: ");
    Serial.println(AP_PASSWORD);

    Serial.print("Dashboard IP: ");
    Serial.println(WiFi.softAPIP());
  }
  else
  {
    Serial.println("Failed to start hotspot.");
  }
}


// =====================================================
// HANDLE SET PLANT FROM WEB
// =====================================================

void handleSetPlant()
{
  if (server.hasArg("code"))
  {
    int code = server.arg("code").toInt();

    if (code >= 1 && code <= 3)
    {
      selectPlant(code);

      server.send(
        200,
        "text/plain",
        "OK"
      );
    }
    else
    {
      server.send(
        400,
        "text/plain",
        "Invalid plant code"
      );
    }
  }
  else
  {
    server.send(
      400,
      "text/plain",
      "Missing code parameter"
    );
  }
}


