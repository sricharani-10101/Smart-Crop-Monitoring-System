// =====================================================
// PIN DEFINITIONS
// =====================================================

#define DHT_PIN 26
#define DHT_TYPE DHT11

#define SOIL_PIN 33
#define RAIN_PIN 35
#define WATER_LEVEL_PIN 32

#define RELAY_PIN 4

#define SDA_PIN 21
#define SCL_PIN 22


// =====================================================
// OBJECTS
// =====================================================

DHT dht(DHT_PIN, DHT_TYPE);

hd44780_I2Cexp lcd;


// =====================================================
// SOIL MOISTURE CALIBRATION
// =====================================================

int SOIL_DRY = 3200;
int SOIL_WET = 1200;


// =====================================================
// RAIN SENSOR CALIBRATION
// =====================================================

int RAIN_DRY = 4095;
int RAIN_WET = 1500;


// =====================================================
// WATER LEVEL SENSOR CALIBRATION
// =====================================================
// Sensor reads low when water is low, high when water
// is high. Adjust these values after testing your sensor.
// WATER_EMPTY = ADC reading when tank is empty
// WATER_FULL  = ADC reading when tank is full

int WATER_EMPTY = 0;
int WATER_FULL = 2500;

// Minimum water level (%) to allow pump operation.
// Below this level the pump will NOT turn on to
// prevent dry-running and save battery.
int WATER_MIN_LEVEL = 15;


// =====================================================
// PLANT DATA STRUCTURE
// =====================================================

struct PlantProfile
{
  const char* name;
  int code;
  int pumpOnBelow;
  int pumpOffAt;
};


// =====================================================
// PLANT PROFILES (from sensor calibration data)
// =====================================================

// Plant 1: Portulaca           - Pump ON below 40%, Pump OFF at 72%
// Plant 2: Moses-in-the-cradle - Pump ON below 55%, Pump OFF at 72%
// Plant 3: Periwinkle          - Pump ON below 47%, Pump OFF at 72%

PlantProfile plants[3] =
{
  { "Portulaca",            1, 40, 72 },
  { "Moses-in-the-cradle",  2, 55, 72 },
  { "Periwinkle",           3, 47, 72 }
};


