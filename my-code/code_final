// =====================================================
// SEND SENSOR DATA AS JSON
// =====================================================

void handleData()
{

  // ---------------------------------------------------
  // SOIL STATUS
  // ---------------------------------------------------

  String soilStatus;

  if (soilMoisture <= MOISTURE_THRESHOLD)
  {
    soilStatus = "DRY";
  }
  else if (soilMoisture >= MOISTURE_STOP)
  {
    soilStatus = "WET";
  }
  else
  {
    soilStatus = "NORMAL";
  }


  // ---------------------------------------------------
  // RAIN STATUS
  // ---------------------------------------------------

  String rainStatus;

  if (rainPercentage >= 20)
  {
    rainStatus = "RAIN DETECTED";
  }
  else
  {
    rainStatus = "NO RAIN";
  }


  // ---------------------------------------------------
  // TEMPERATURE STATUS
  // ---------------------------------------------------

  String temperatureStatus;

  if (temperature < 20)
  {
    temperatureStatus = "COOL";
  }
  else if (temperature <= 35)
  {
    temperatureStatus = "NORMAL";
  }
  else
  {
    temperatureStatus = "HIGH";
  }


  // ---------------------------------------------------
  // WATER LEVEL STATUS
  // ---------------------------------------------------

  String waterStatus;

  if (waterLow)
  {
    waterStatus = "LOW - PUMP BLOCKED";
  }
  else if (waterLevel < 30)
  {
    waterStatus = "LOW";
  }
  else if (waterLevel < 60)
  {
    waterStatus = "MEDIUM";
  }
  else
  {
    waterStatus = "FULL";
  }


  // ---------------------------------------------------
  // PUMP REASON
  // ---------------------------------------------------

  String pumpReason;

  if (waterLow)
  {
    pumpReason =
      "Pump is disabled. Tank water level is below ";
    pumpReason += String(WATER_MIN_LEVEL);
    pumpReason += "%. Refill the tank to resume irrigation.";
  }
  else if (pumpStatus)
  {
    pumpReason =
      "Soil is dry and no significant rain detected.";
  }
  else if (rainPercentage >= 20)
  {
    pumpReason =
      "Irrigation stopped because rain was detected.";
  }
  else if (soilMoisture >= MOISTURE_STOP)
  {
    pumpReason =
      "Soil moisture is sufficient.";
  }
  else
  {
    pumpReason =
      "Irrigation is currently on standby.";
  }


  // ---------------------------------------------------
  // SUMMARY
  // ---------------------------------------------------

  String summary;

  if (waterLow)
  {
    summary = "Water Low";
  }
  else if (pumpStatus)
  {
    summary = "Irrigating";
  }
  else if (rainPercentage >= 20)
  {
    summary = "Rain Detected";
  }
  else if (soilMoisture >= MOISTURE_STOP)
  {
    summary = "Moisture OK";
  }
  else
  {
    summary = "Monitoring";
  }


  // ---------------------------------------------------
  // CREATE JSON
  // ---------------------------------------------------

  String json = "{";

  json += "\"soil\":";
  json += String(soilMoisture);

  json += ",\"temperature\":";
  json += String(temperature, 1);

  json += ",\"humidity\":";
  json += String(humidity, 1);

  json += ",\"rain\":";
  json += String(rainPercentage);

  json += ",\"water\":";
  json += String(waterLevel);

  json += ",\"waterLow\":";
  json += waterLow ? "true" : "false";

  json += ",\"waterMinLevel\":";
  json += String(WATER_MIN_LEVEL);

  json += ",\"pump\":\"";
  json += pumpStatus ? "ON" : "OFF";
  json += "\"";

  json += ",\"soilStatus\":\"";
  json += soilStatus;
  json += "\"";

  json += ",\"rainStatus\":\"";
  json += rainStatus;
  json += "\"";

  json += ",\"temperatureStatus\":\"";
  json += temperatureStatus;
  json += "\"";

  json += ",\"waterStatus\":\"";
  json += waterStatus;
  json += "\"";

  json += ",\"pumpReason\":\"";
  json += pumpReason;
  json += "\"";

  json += ",\"summary\":\"";
  json += summary;
  json += "\"";

  json += ",\"plantName\":\"";
  json += plants[selectedPlant].name;
  json += "\"";

  json += ",\"plantCode\":";
  json += String(plants[selectedPlant].code);

  json += ",\"thresholdOn\":";
  json += String(MOISTURE_THRESHOLD);

  json += ",\"thresholdOff\":";
  json += String(MOISTURE_STOP);

  json += ",\"readings\":";
  json += String(readingCount);

  json += "}";


  server.send(
    200,
    "application/json",
    json
  );
}


