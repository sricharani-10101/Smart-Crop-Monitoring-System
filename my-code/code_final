// =====================================================
// IRRIGATION CONTROL
// =====================================================

void irrigationControl()
{

  /*
    PUMP ON conditions:
      Soil moisture <= MOISTURE_THRESHOLD (plant-specific)
      AND rain < 20%
      AND water level >= WATER_MIN_LEVEL (tank has enough water)

    PUMP OFF conditions:
      Soil moisture >= MOISTURE_STOP (plant-specific)
      OR rain >= 20%
      OR water level < WATER_MIN_LEVEL (tank water too low)
  */


  // ---------------------------------------------------
  // SAFETY CHECK: WATER LEVEL TOO LOW
  // If tank water is below minimum, force pump OFF
  // to prevent dry-running and save battery.
  // ---------------------------------------------------

  if (waterLow)
  {
    if (pumpStatus)
    {
      pumpStatus = false;

      digitalWrite(
        RELAY_PIN,
        RELAY_OFF
      );

      Serial.println(
        "IRRIGATION: PUMP OFF - WATER LEVEL TOO LOW!"
      );
    }

    return;  // Skip normal irrigation logic
  }


  // ---------------------------------------------------
  // PUMP ON
  // ---------------------------------------------------

  if (
    soilMoisture <= MOISTURE_THRESHOLD &&
    rainPercentage < 20
  )
  {
    pumpStatus = true;

    digitalWrite(
      RELAY_PIN,
      RELAY_ON
    );

    Serial.println(
      "IRRIGATION: PUMP ON"
    );
  }


  // ---------------------------------------------------
  // PUMP OFF
  // ---------------------------------------------------

  else if (
    soilMoisture >= MOISTURE_STOP ||
    rainPercentage >= 20
  )
  {
    pumpStatus = false;

    digitalWrite(
      RELAY_PIN,
      RELAY_OFF
    );

    Serial.println(
      "IRRIGATION: PUMP OFF"
    );
  }
}


