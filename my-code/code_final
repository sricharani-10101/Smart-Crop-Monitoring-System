// =====================================================

#define RELAY_ON LOW
#define RELAY_OFF HIGH


// =====================================================
// VARIABLES
// =====================================================

float temperature = 0;
float humidity = 0;

int soilRaw = 0;
int rainRaw = 0;
int waterRaw = 0;

int soilMoisture = 0;
int rainPercentage = 0;
int waterLevel = 0;

