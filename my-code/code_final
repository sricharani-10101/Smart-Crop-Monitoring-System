// CURRENTLY SELECTED PLANT (0-indexed internally)
// =====================================================

int selectedPlant = 0;  // Default: Portulaca (code 1)

int MOISTURE_THRESHOLD = 40;  // Pump ON below this
int MOISTURE_STOP = 72;       // Pump OFF at this


// =====================================================
