function drawGraph(canvasId, data, lineColor, minV, maxV, unit, thresholdLine) {
  var c = document.getElementById(canvasId);
  var ctx = c.getContext('2d');
  var W = c.width = c.offsetWidth;
  var H = c.height = 180;
  var pad = {t:20, b:30, l:45, r:15};
  var gW = W - pad.l - pad.r;
  var gH = H - pad.t - pad.b;

  ctx.clearRect(0, 0, W, H);

  // Background
  ctx.fillStyle = '#f8fcf9';
  ctx.fillRect(pad.l, pad.t, gW, gH);

  // Grid lines
  ctx.strokeStyle = '#e0ece4';
  ctx.lineWidth = 1;
  for (var i = 0; i <= 4; i++) {
    var y = pad.t + (gH / 4) * i;
    ctx.beginPath();
    ctx.moveTo(pad.l, y);
    ctx.lineTo(W - pad.r, y);
    ctx.stroke();
  }

  // Threshold line (optional)
  if (typeof thresholdLine !== 'undefined' && thresholdLine !== null) {
    var ty = pad.t + gH - ((thresholdLine - minV) / (maxV - minV)) * gH;
    ctx.strokeStyle = '#f87171';
    ctx.lineWidth = 1.5;
    ctx.setLineDash([6, 4]);
    ctx.beginPath();
    ctx.moveTo(pad.l, ty);
    ctx.lineTo(W - pad.r, ty);
    ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillStyle = '#d93025';
    ctx.font = '10px Segoe UI, sans-serif';
    ctx.textAlign = 'left';
    ctx.fillText('Min ' + thresholdLine + unit, pad.l + 4, ty - 4);
  }

  // Y-axis labels
  ctx.fillStyle = '#6b8f7a';
  ctx.font = '11px Segoe UI, sans-serif';
  ctx.textAlign = 'right';
  for (var i = 0; i <= 4; i++) {
    var val = maxV - ((maxV - minV) / 4) * i;
    var y = pad.t + (gH / 4) * i;
    ctx.fillText(val.toFixed(0) + unit, pad.l - 6, y + 4);
  }

  if (data.length < 2) {
    ctx.fillStyle = '#8aaa97';
    ctx.font = '13px Segoe UI, sans-serif';
    ctx.textAlign = 'center';
    ctx.fillText('Collecting data...', W / 2, H / 2);
    return;
  }

  // Draw line
  ctx.strokeStyle = lineColor;
  ctx.lineWidth = 2.5;
  ctx.lineJoin = 'round';
  ctx.beginPath();
  for (var i = 0; i < data.length; i++) {
    var x = pad.l + (gW / (MAX_PTS - 1)) * i;
    var v = data[i];
    if (v < minV) v = minV;
    if (v > maxV) v = maxV;
    var y = pad.t + gH - ((v - minV) / (maxV - minV)) * gH;
    if (i === 0) ctx.moveTo(x, y);
    else ctx.lineTo(x, y);
  }
  ctx.stroke();

  // Fill area under line
  ctx.lineTo(pad.l + (gW / (MAX_PTS - 1)) * (data.length - 1), pad.t + gH);
  ctx.lineTo(pad.l, pad.t + gH);
  ctx.closePath();
  ctx.fillStyle = lineColor.replace(')', ',0.1)').replace('rgb', 'rgba');
  ctx.fill();

  // Data points
  ctx.fillStyle = lineColor;
  for (var i = 0; i < data.length; i++) {
    var x = pad.l + (gW / (MAX_PTS - 1)) * i;
    var v = data[i];
    if (v < minV) v = minV;
    if (v > maxV) v = maxV;
    var y = pad.t + gH - ((v - minV) / (maxV - minV)) * gH;
    ctx.beginPath();
    ctx.arc(x, y, 3, 0, Math.PI * 2);
    ctx.fill();
  }

  // X-axis label
  ctx.fillStyle = '#8aaa97';
  ctx.font = '11px Segoe UI, sans-serif';
  ctx.textAlign = 'center';
  ctx.fillText('Readings', W / 2, H - 4);
}

var storedWaterMin = 15;

function setPlant(code) {
  fetch('/setplant?code=' + code)
  .then(function(r) { return r.text(); })
  .then(function() { updateDashboard(); })
  .catch(function(e) { console.log('Error:', e); });
}

function updateDashboard() {
  fetch('/data')
  .then(function(r) { return r.json(); })
  .then(function(data) {

    // Sensor values
    document.getElementById('soil').innerHTML = data.soil;
    document.getElementById('temperature').innerHTML = data.temperature;
    document.getElementById('humidity').innerHTML = data.humidity;
    document.getElementById('rain').innerHTML = data.rain;
    document.getElementById('water').innerHTML = data.water;

    // Status tags
    document.getElementById('soilStatus').innerHTML = data.soilStatus;
    document.getElementById('temperatureStatus').innerHTML = data.temperatureStatus;
    document.getElementById('rainStatus').innerHTML = data.rainStatus;

    // Water status tag
    var waterTag = document.getElementById('waterStatus');
    var waterCard = document.getElementById('waterCard');
    waterTag.innerHTML = data.waterStatus;
    if (data.waterLow) {
      waterTag.className = 'tag warning';
      waterCard.className = 'sensor-card alert';
    } else {
      waterTag.className = 'tag';
      waterCard.className = 'sensor-card';
    }

    // Water alert banner
    var alertBanner = document.getElementById('waterAlert');
    if (data.waterLow) {
      alertBanner.className = 'water-alert show';
    } else {
      alertBanner.className = 'water-alert';
    }

    // Plant info
    document.getElementById('plantName').innerHTML = data.plantName;
    document.getElementById('plantCode').innerHTML = data.plantCode;
    document.getElementById('thresholdOn').innerHTML = data.thresholdOn + '%';
    document.getElementById('thresholdOff').innerHTML = data.thresholdOff + '%';

    // System status
    document.getElementById('sysStatus').innerHTML = data.summary;
    document.getElementById('readingCount').innerHTML = data.readings;
    storedWaterMin = data.waterMinLevel;
    document.getElementById('waterMinLevel').innerHTML = data.waterMinLevel + '%';

    // Water state in system panel
    var waterStateEl = document.getElementById('waterState');
    waterStateEl.innerHTML = data.water + '% - ' + data.waterStatus;
    if (data.waterLow) {
      waterStateEl.className = 'info-value water-low';
    } else {
      waterStateEl.className = 'info-value water-ok';
    }

    // Pump
    var pumpEl = document.getElementById('pumpCircle');
    var pumpLabel = document.getElementById('pumpLabel');
    var pumpStateEl = document.getElementById('pumpState');

    if (data.waterLow) {
      pumpEl.className = 'pump-indicator blocked';
      pumpEl.innerHTML = 'OFF';
      pumpLabel.innerHTML = 'Pump BLOCKED - Low Water';
      pumpStateEl.innerHTML = 'BLOCKED';
      pumpStateEl.className = 'info-value pump-on';
    } else if (data.pump === 'ON') {
      pumpEl.className = 'pump-indicator on';
      pumpEl.innerHTML = 'ON';
      pumpLabel.innerHTML = 'Irrigation Pump - ON';
      pumpStateEl.innerHTML = 'ON';
      pumpStateEl.className = 'info-value pump-on';
    } else {
      pumpEl.className = 'pump-indicator off';
      pumpEl.innerHTML = 'OFF';
      pumpLabel.innerHTML = 'Irrigation Pump - OFF';
      pumpStateEl.innerHTML = 'OFF';
      pumpStateEl.className = 'info-value pump-off';
    }

    document.getElementById('pumpReason').innerHTML = data.pumpReason;

    // Plant selector buttons
    var btns = document.querySelectorAll('.plant-btn');
    for (var i = 0; i < btns.length; i++) {
      btns[i].className = 'plant-btn';
    }
    if (data.plantCode >= 1 && data.plantCode <= 3) {
      btns[data.plantCode - 1].className = 'plant-btn active';
    }

    // Update graph data
    tempData.push(parseFloat(data.temperature));
    humData.push(parseFloat(data.humidity));
    soilData.push(parseInt(data.soil));
    rainData.push(parseInt(data.rain));
    waterData.push(parseInt(data.water));

    if (tempData.length > MAX_PTS) tempData.shift();
    if (humData.length > MAX_PTS) humData.shift();
    if (soilData.length > MAX_PTS) soilData.shift();
    if (rainData.length > MAX_PTS) rainData.shift();
    if (waterData.length > MAX_PTS) waterData.shift();

    redrawAllGraphs();

    // Last update
    var now = new Date();
    document.getElementById('lastUpdate').innerHTML = now.toLocaleTimeString();

  })
  .catch(function(e) { console.log('Connection error:', e); });
}

function redrawAllGraphs() {
  drawGraph('tempChart', tempData, 'rgb(234, 67, 53)', 0, 50, ' C', null);
  drawGraph('humChart', humData, 'rgb(66, 133, 244)', 0, 100, '%', null);
  drawGraph('soilChart', soilData, 'rgb(52, 168, 83)', 0, 100, '%', null);
  drawGraph('rainChart', rainData, 'rgb(99, 143, 210)', 0, 100, '%', null);
  drawGraph('waterChart', waterData, 'rgb(14, 165, 233)', 0, 100, '%', storedWaterMin);
}

// Auto-refresh every 2 seconds
setInterval(updateDashboard, 2000);

// Initial load
updateDashboard();

// Redraw graphs on window resize
window.addEventListener('resize', function() {
  redrawAllGraphs();
});

</script>
