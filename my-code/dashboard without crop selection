// =====================================================
// SEND SENSOR DATA AS JSON
// =====================================================

void handleData()
{
  // No-cache headers
  server.sendHeader("Cache-Control", "no-store, no-cache, must-revalidate");
  server.sendHeader("Pragma", "no-cache");

  const PlantProfile& plant = PLANTS[SELECTED_PLANT - 1];


  // ---------------------------------------------------
  // SOIL STATUS
  // ---------------------------------------------------

  String soilStatus;

  if (soilMoisture < plant.pumpOnBelow)
  {
    soilStatus = "DRY";
  }
  else if (soilMoisture >= plant.pumpOffAt)
  {
    soilStatus = "WET";
  }
  else
  {
    soilStatus = "NORMAL";
  }


  // ---------------------------------------------------
  // RAIN STATUS
  // ---------------------------------------------------

  String rainStatus = (rainPercentage >= 20) ? "RAIN DETECTED" : "NO RAIN";


  // ---------------------------------------------------
  // TEMPERATURE STATUS
  // ---------------------------------------------------

  String temperatureStatus;

  if (temperature < 20)
  {
    temperatureStatus = "COOL";
  }
  else if (temperature <= 35)
  {
    temperatureStatus = "NORMAL";
  }
  else
  {
    temperatureStatus = "HIGH";
  }


  // ---------------------------------------------------
  // PUMP REASON
  // ---------------------------------------------------

  String pumpReason;

  if (pumpStatus)
  {
    pumpReason =
      "Soil is dry and no significant rain detected.";
  }
  else if (rainPercentage >= 20)
  {
    pumpReason =
      "Irrigation stopped because rain was detected.";
  }
  else if (soilMoisture >= plant.pumpOffAt)
  {
    pumpReason =
      "Soil moisture is sufficient.";
  }
  else
  {
    pumpReason =
      "Irrigation is currently on standby.";
  }


  // ---------------------------------------------------
  // SYSTEM STATUS
  // ---------------------------------------------------

  String systemStatus;

  if (pumpStatus)
  {
    systemStatus = "Irrigating";
  }
  else if (rainPercentage >= 20)
  {
    systemStatus = "Rain Detected - Paused";
  }
  else if (soilMoisture >= plant.pumpOffAt)
  {
    systemStatus = "Soil Sufficient - Standby";
  }
  else
  {
    systemStatus = "Monitoring";
  }


  // ---------------------------------------------------
  // CREATE JSON
  // ---------------------------------------------------

  String json = "{";

  json += "\"soil\":"            + String(soilMoisture);
  json += ",\"temperature\":"    + String(temperature, 1);
  json += ",\"humidity\":"       + String(humidity, 1);
  json += ",\"rain\":"           + String(rainPercentage);

  json += ",\"pump\":\""         + String(pumpStatus ? "ON" : "OFF") + "\"";
  json += ",\"soilStatus\":\""   + soilStatus          + "\"";
  json += ",\"rainStatus\":\""   + rainStatus          + "\"";
  json += ",\"temperatureStatus\":\"" + temperatureStatus + "\"";
  json += ",\"pumpReason\":\""   + pumpReason          + "\"";
  json += ",\"systemStatus\":\"" + systemStatus        + "\"";

  json += ",\"plantName\":\""    + String(plant.name)  + "\"";
  json += ",\"plantCode\":"      + String(SELECTED_PLANT);
  json += ",\"threshOn\":"       + String(plant.pumpOnBelow);
  json += ",\"threshOff\":"      + String(plant.pumpOffAt);
  json += ",\"readingCount\":"   + String(readingCount);

  json += ",\"soilRaw\":"        + String(soilRaw);
  json += ",\"rainRaw\":"        + String(rainRaw);

  json += "}";


  server.send(200, "application/json", json);
}


// =====================================================
// LCD DISPLAY
// =====================================================

void displaySensorData()
{
  const PlantProfile& plant = PLANTS[SELECTED_PLANT - 1];

  // ---------------------------------------------------
  // SCREEN 1 – sensor readings
  // ---------------------------------------------------

  lcd.clear();

  lcd.setCursor(0, 0);
  lcd.print("Soil:");
  lcd.print(soilMoisture);
  lcd.print("%");

  lcd.setCursor(9, 0);
  lcd.print("Rain:");
  lcd.print(rainPercentage);
  lcd.print("%");

  lcd.setCursor(0, 1);
  lcd.print("T:");
  lcd.print(temperature, 1);
  lcd.print("C ");

  lcd.print("H:");
  lcd.print(humidity, 0);
  lcd.print("%");

  delay(1500);


  // ---------------------------------------------------
  // SCREEN 2 – plant & pump info
  // ---------------------------------------------------

  lcd.clear();

  lcd.setCursor(0, 0);
  String pLine = "P" + String(SELECTED_PLANT) + ":" + String(plant.name);
  if (pLine.length() > 16) pLine = pLine.substring(0, 16);
  lcd.print(pLine);

  lcd.setCursor(0, 1);
  lcd.print("Pump:");
  lcd.print(pumpStatus ? "ON " : "OFF");

  if (rainPercentage >= 20)
  {
    lcd.print("Rain");
  }
  else
  {
    lcd.print("    ");
  }
}


// =====================================================
// IRRIGATION CONTROL
// =====================================================

void irrigationControl()
{
  const PlantProfile& plant = PLANTS[SELECTED_PLANT - 1];

  /*
    PUMP ON  : soil < pumpOnBelow  AND  rain < 20%
    PUMP OFF : soil >= pumpOffAt   OR   rain >= 20%
  */


  // ---------------------------------------------------
  // PUMP ON
  // ---------------------------------------------------

  if (
    soilMoisture < plant.pumpOnBelow &&
    rainPercentage < 20
  )
  {
    pumpStatus = true;

    digitalWrite(RELAY_PIN, RELAY_ON);

    Serial.println("IRRIGATION: PUMP ON");
  }


  // ---------------------------------------------------
  // PUMP OFF
  // ---------------------------------------------------

  else if (
    soilMoisture >= plant.pumpOffAt ||
    rainPercentage >= 20
  )
  {
    pumpStatus = false;

    digitalWrite(RELAY_PIN, RELAY_OFF);

    Serial.println("IRRIGATION: PUMP OFF");
  }
}


