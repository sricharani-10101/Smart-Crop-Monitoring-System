  var t = parseFloat(d.temperature);
  var h = parseFloat(d.humidity);
  var r = parseFloat(d.rain);

  // Push history
  pushArr(hSoil, s);
  pushArr(hTemp, Math.min(t, 60));
  pushArr(hHum,  h);
  pushArr(hRain, r);

  // Metrics
  document.getElementById('soil').textContent        = d.soil;
  document.getElementById('temperature').textContent = d.temperature;
  document.getElementById('humidity').textContent    = d.humidity;
  document.getElementById('rain').textContent        = d.rain;

  document.getElementById('soilRawLbl').textContent =
    d.soilRaw !== undefined ? 'ADC: ' + d.soilRaw : 'ADC: --';
  document.getElementById('rainRawLbl').textContent =
    d.rainRaw !== undefined ? 'ADC: ' + d.rainRaw : 'ADC: --';

  // Progress bars
  document.getElementById('soilBar').style.width     = s + '%';
  document.getElementById('soilBar').style.background =
    s < d.threshOn ? '#c0392b' : s >= d.threshOff ? '#3a9e6c' : '#c47d00';

  var tPct = Math.min(Math.max(t / 50 * 100, 0), 100);
  document.getElementById('tempBar').style.width     = tPct + '%';
  document.getElementById('tempBar').style.background =
    t < 20 ? '#2260a8' : t <= 35 ? '#3a9e6c' : '#c0392b';

  document.getElementById('humidityBar').style.width = h + '%';

  document.getElementById('rainBar').style.width     = r + '%';
  document.getElementById('rainBar').style.background =
    r >= 20 ? '#2260a8' : '#3a9e6c';

  // Tags
  var soilTagCls = s < d.threshOn ? 't-dry' : s >= d.threshOff ? 't-wet' : 't-warn';
  setTag('soilTag', d.soilStatus, soilTagCls);

  var tempTagCls = t < 20 ? 't-cool' : t <= 35 ? '' : 't-high';
  setTag('tempTag', d.temperatureStatus, tempTagCls);

  var rainTagCls = r >= 20 ? 't-rain' : '';
  setTag('rainTag', d.rainStatus, rainTagCls);

  // Pump
  var pumpEl = document.getElementById('pump');
  pumpEl.textContent  = d.pump;
  pumpEl.style.color  = d.pump === 'ON' ? '#256b45' : '#628f77';

  document.getElementById('pumpReason').textContent = d.pumpReason;

  // Status banner
  document.getElementById('systemStatus').textContent = d.systemStatus;
  document.getElementById('plantName').textContent    = d.plantName;
  document.getElementById('plantCode').textContent    = d.plantCode;
  document.getElementById('threshOn').textContent     = d.threshOn + '%';
  document.getElementById('threshOff').textContent    = d.threshOff + '%';
  document.getElementById('readingCount').textContent = d.readingCount;

  // Redraw charts
  redrawAll();

  // Timestamp
  document.getElementById('lastUpdate').textContent =
    new Date().toLocaleTimeString();
}

