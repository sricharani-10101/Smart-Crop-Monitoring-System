// =========================================================
// CHART HELPERS
// =========================================================

var MAX_PTS = 20;

var hSoil = [], hTemp = [], hHum = [], hRain = [];

function pushArr(arr, val) {
  arr.push(val);
  if (arr.length > MAX_PTS) arr.shift();
}

// Draw a simple line/fill chart on a canvas
function drawChart(id, data, lineColor, fillColor, yMin, yMax) {
  var c = document.getElementById(id);
  if (!c) return;
  var dpr = window.devicePixelRatio || 1;
  var W   = c.offsetWidth;
  var H   = 110;
  c.width  = W * dpr;
  c.height = H * dpr;
  c.style.height = H + 'px';
  var ctx = c.getContext('2d');
  ctx.scale(dpr, dpr);
  ctx.clearRect(0, 0, W, H);

  var padL = 30, padR = 8, padT = 8, padB = 22;
  var iW = W - padL - padR;
  var iH = H - padT - padB;

  // Y grid lines + labels
  var gridSteps = [0, 25, 50, 75, 100];
  ctx.font = '9px Segoe UI, Arial';
  ctx.fillStyle = '#8aac9a';
  ctx.strokeStyle = '#d4efe1';
  ctx.lineWidth = 1;
  gridSteps.forEach(function(g) {
    var y = padT + iH * (1 - (g - yMin) / (yMax - yMin));
    if (y < padT || y > padT + iH) return;
    ctx.beginPath();
    ctx.moveTo(padL, y);
    ctx.lineTo(padL + iW, y);
    ctx.stroke();
    ctx.fillText(g, 0, y + 3);
  });

  if (data.length < 2) return;

  function px(i)  { return padL + i / (MAX_PTS - 1) * iW; }
  function py(v)  { return padT + iH * (1 - (v - yMin) / (yMax - yMin)); }

  // Fill
  var grad = ctx.createLinearGradient(0, padT, 0, padT + iH);
  grad.addColorStop(0, fillColor);
  grad.addColorStop(1, 'rgba(255,255,255,0)');

  ctx.beginPath();
  var offset = MAX_PTS - data.length;
  ctx.moveTo(px(offset), padT + iH);
  for (var i = 0; i < data.length; i++) {
    ctx.lineTo(px(offset + i), py(data[i]));
  }
  ctx.lineTo(px(offset + data.length - 1), padT + iH);
  ctx.closePath();
  ctx.fillStyle = grad;
  ctx.fill();

  // Line
  ctx.beginPath();
  for (var i = 0; i < data.length; i++) {
    var x = px(offset + i), y = py(data[i]);
    i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
  }
  ctx.strokeStyle = lineColor;
  ctx.lineWidth = 2;
  ctx.lineJoin = 'round';
  ctx.stroke();

  // X-axis labels (start / mid / end)
  ctx.fillStyle = '#8aac9a';
  ctx.font = '9px Segoe UI, Arial';
  ctx.fillText(1,              padL,        H - 6);
  ctx.fillText(MAX_PTS / 2,    padL + iW/2, H - 6);
  ctx.fillText(MAX_PTS,        padL + iW,   H - 6);
}

