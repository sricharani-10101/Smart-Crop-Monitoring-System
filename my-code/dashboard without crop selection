// =====================================================
// ESP32 ACCESS POINT SETTINGS
// =====================================================

const char* AP_SSID     = "Smart_Crop_Monitor";
const char* AP_PASSWORD = "SmartCrop123";

WebServer server(80);


// =====================================================
// PIN DEFINITIONS
// =====================================================

#define DHT_PIN  26
#define DHT_TYPE DHT11

#define SOIL_PIN 33
#define RAIN_PIN 35

#define RELAY_PIN 4

#define SDA_PIN 21
#define SCL_PIN 22


// =====================================================
// OBJECTS
// =====================================================

DHT dht(DHT_PIN, DHT_TYPE);

hd44780_I2Cexp lcd;


// =====================================================
// SOIL MOISTURE CALIBRATION
// =====================================================

int SOIL_DRY = 3200;
int SOIL_WET = 1200;


// =====================================================
// RAIN SENSOR CALIBRATION
// =====================================================

int RAIN_DRY = 4095;
int RAIN_WET = 1500;


// =====================================================
// RELAY SETTINGS
// =====================================================

#define RELAY_ON  LOW
#define RELAY_OFF HIGH


// =====================================================
// PLANT DATABASE
//   Plant 1 : Portulaca           – ON < 40%  OFF >= 72%
//   Plant 2 : Moses-in-the-cradle – ON < 55%  OFF >= 72%
//   Plant 3 : Periwinkle          – ON < 47%  OFF >= 72%
// =====================================================

struct PlantProfile
{
  const char* name;
  int         pumpOnBelow;   // start pump when soil % is below this
  int         pumpOffAt;     // stop  pump when soil % reaches this
};

const PlantProfile PLANTS[3] =
{
  { "Portulaca",           40, 72 },  // Plant 1
  { "Moses-in-the-cradle", 55, 72 },  // Plant 2
  { "Periwinkle",          47, 72 }   // Plant 3
};

// Active plant – change to 1, 2, or 3 and re-upload to switch plant
int SELECTED_PLANT = 1;


// =====================================================
// VARIABLES
// =====================================================

float temperature    = 0;
float humidity       = 0;

int   soilRaw        = 0;
int   rainRaw        = 0;

int   soilMoisture   = 0;
int   rainPercentage = 0;

bool  pumpStatus     = false;

unsigned long readingCount = 0;


// =====================================================
// FUNCTION DECLARATIONS
// =====================================================

void startAccessPoint();
void displaySensorData();
void irrigationControl();
void printSerialData();
void handleRoot();
void handleData();


// =====================================================
// SETUP
// =====================================================

void setup()
{
  Serial.begin(115200);

  // Clamp plant selection to valid range
  if (SELECTED_PLANT < 1 || SELECTED_PLANT > 3)
  {
    SELECTED_PLANT = 1;
  }


  // ---------------------------------------------------
  // RELAY
  // ---------------------------------------------------

  pinMode(RELAY_PIN, OUTPUT);
  digitalWrite(RELAY_PIN, RELAY_OFF);


  // ---------------------------------------------------
  // I2C
  // ---------------------------------------------------

  Wire.begin(SDA_PIN, SCL_PIN);


  // ---------------------------------------------------
  // LCD
  // ---------------------------------------------------

  int status = lcd.begin(16, 2);

  if (status)
  {
    Serial.print("LCD initialization failed, status = ");
    Serial.println(status);
    // Continue even if LCD fails.
  }
  else
  {
    lcd.backlight();
    lcd.clear();

    lcd.setCursor(0, 0);
    lcd.print("Smart Irrigation");

    lcd.setCursor(0, 1);
    lcd.print("System Starting");

    delay(2000);
  }


  // ---------------------------------------------------
  // DHT11
  // ---------------------------------------------------

  dht.begin();


  // ---------------------------------------------------
  // ADC
  // ---------------------------------------------------

  analogReadResolution(12);


  // ---------------------------------------------------
  // START ESP32 HOTSPOT
  // ---------------------------------------------------

  startAccessPoint();


  // ---------------------------------------------------
  // WEB SERVER ROUTES
  // ---------------------------------------------------

  server.on("/",     handleRoot);
  server.on("/data", handleData);

  server.begin();

  Serial.println("Web server started.");


  // ---------------------------------------------------
  // READY SCREEN
  // ---------------------------------------------------

  if (status == 0)
  {
    lcd.clear();

    lcd.setCursor(0, 0);
    lcd.print("WiFi Ready");

    lcd.setCursor(0, 1);
    lcd.print("192.168.4.1");

    delay(2000);

    lcd.clear();

    lcd.setCursor(0, 0);
    String pLine = "P" + String(SELECTED_PLANT) + " Selected";
    lcd.print(pLine);

    lcd.setCursor(0, 1);
    String pName = String(PLANTS[SELECTED_PLANT - 1].name);
    if (pName.length() > 16) pName = pName.substring(0, 16);
    lcd.print(pName);

    delay(2000);
  }
}


// =====================================================
// MAIN LOOP
// =====================================================

void loop()
{
  // ---------------------------------------------------
  // HANDLE WEB REQUESTS
  // ---------------------------------------------------

  server.handleClient();


  // ---------------------------------------------------
  // SOIL MOISTURE
  // ---------------------------------------------------

  soilRaw = analogRead(SOIL_PIN);

  soilMoisture = map(
    soilRaw,
    SOIL_DRY,
    SOIL_WET,
    0,
    100
  );

  soilMoisture = constrain(soilMoisture, 0, 100);


  // ---------------------------------------------------
  // RAIN SENSOR
  // ---------------------------------------------------

  rainRaw = analogRead(RAIN_PIN);

  rainPercentage = map(
    rainRaw,
    RAIN_DRY,
    RAIN_WET,
    0,
    100
  );

  rainPercentage = constrain(rainPercentage, 0, 100);


  // ---------------------------------------------------
  // DHT11
  // ---------------------------------------------------

  humidity    = dht.readHumidity();
  temperature = dht.readTemperature();

  if (isnan(humidity) || isnan(temperature))
  {
    Serial.println("DHT11 reading failed!");
    delay(1000);
    return;
  }


  // ---------------------------------------------------
  // INCREMENT READING COUNTER
  // ---------------------------------------------------

  readingCount++;


  // ---------------------------------------------------
  // IRRIGATION CONTROL
  // ---------------------------------------------------

  irrigationControl();


  // ---------------------------------------------------
  // DISPLAY
  // ---------------------------------------------------

  displaySensorData();


  // ---------------------------------------------------
  // SERIAL MONITOR
  // ---------------------------------------------------

  printSerialData();


  delay(2000);
}


// =====================================================
// START ESP32 ACCESS POINT
// =====================================================

void startAccessPoint()
{
  Serial.println();
  Serial.println("Starting ESP32 Wi-Fi Hotspot...");

  WiFi.mode(WIFI_AP);

  bool result = WiFi.softAP(AP_SSID, AP_PASSWORD);

  if (result)
  {
    Serial.println("Hotspot started successfully.");

    Serial.print("Wi-Fi Name: ");
    Serial.println(AP_SSID);

    Serial.print("Wi-Fi Password: ");
    Serial.println(AP_PASSWORD);

    Serial.print("Dashboard IP: ");
    Serial.println(WiFi.softAPIP());
  }
  else
  {
    Serial.println("Failed to start hotspot.");
  }
}






